# 复制为 .env 后填写，docker compose 会自动读取。
#
# ---------- 对外：保护 /v1/* 接口 ----------
# 生成方式：node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('hex'))"
H3_SERVER_API_KEY=sk-换成你自己的随机串
H3_MODEL_ID=h3-prompt-writing

# ---------- 监听 ----------
# 容器里固定 8787（Dockerfile 已设）。若宿主机 8787 被别的程序占用，
# 改 docker-compose.yml 的端口映射左侧即可，例如 "8788:8787"。
# PORT=8787

# ---------- 网页控制台登录 ----------
# 公网部署必须设置，否则控制台不可用（服务会拒绝提供，而不是裸奔）。
H3_WEB_USERNAME=admin
H3_WEB_PASSWORD=换成你的强密码
# 也可以不用明文，改为写哈希：
#   node scripts/set-web-password.mjs admin '你的密码'
# 然后删掉上面的 H3_WEB_PASSWORD（哈希存在 config.local.json 里）。

# ---------- 上游：真正的算力来自哪个 NewAPI ----------
# 注意保留 /v1 后缀。/v1 是 OpenAI 兼容路径，NewAPI 的地址本身就是 http://host:3000
H3_UPSTREAM_BASE_URL=http://host.docker.internal:3000/v1
NEWAPI_API_KEY=sk-你在NewAPI里创建的令牌

# 必须选支持图片输入的模型，否则看图的能力会失效
LLM_MODEL=qwen-vl-max
# 可选：规划用小模型省钱，留空则复用 LLM_MODEL
LLM_PLANNER_MODEL=
LLM_TIMEOUT_MS=180000
LLM_REPAIR_PASSES=1
